{
  "name": "@agentgrade/react",
  "version": "0.1.0",
  "description": "Drop-in WebMCP for React: register agent-callable tools with useWebMCP, or make an existing form agent-callable with <AgentForm />.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "keywords": ["webmcp", "mcp", "ai-agent", "react", "agentgrade", "model-context"],
  "publishConfig": { "access": "public" }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@agentgrade/core": [
        "../../src/index.ts"
      ],
      "@agentgrade/core/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "build.mjs"
  ]
}